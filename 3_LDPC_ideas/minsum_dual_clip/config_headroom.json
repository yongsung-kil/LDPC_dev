{
  "_desc": [
    "vanilla reference 실험 설정: 모든 실험의 비교 기준선",
    "상대경로는 이 config 파일 위치 기준 (../../ = 저장소 루트 LDPC_dev)",
    "실행: 이 폴더에서 python run.py (런처가 이 config를 사용)"
  ],
  "H_matrix": {
    "dir": "../../2_LDPC_light/Input/H_matrix",
    "file": "example_18x147_z256.qc"
  },
  "decoder": {
    "use_input_llr_matrix": false,
    "llr_matrix": {
      "dir": "../../2_LDPC_light/Input/LLR",
      "file": "LLR_MATRIX_HD_1.txt"
    },
    "mode": "HD",
    "max_iter": 20,
    "channel_llr_HD": [
      8
    ],
    "channel_llr_2SD": [
      6,
      10
    ],
    "channel_llr_3SD": [
      4,
      6,
      8,
      10
    ],
    "use_default_edge_quantization": false,
    "edge_quantization": {
      "edge_resolution_bits": 3,
      "edge_max_value": 15
    }
  },
  "run": {
    "seed": 0,
    "max_frame_errors": 10,
    "max_frames": 256,
    "frames_per_batch": 64,
    "stop_below_fer": null,
    "progress_interval_frames": 100
  },
  "channels": {
    "type": "fixed_error",
    "fixed_error": [
      200,
      300
    ]
  },
  "log": {
    "enabled": true,
    "items": {
      "csw_per_iter": true,
      "bit_err_per_iter": true,
      "bit_err_by_dv": true,
      "iter_histogram": true,
      "fer_vs_iter": true,
      "fail_frame_detail": true,
      "fer_curve_png": true
    }
  },
  "output": {
    "_desc": "결과는 이 아이디어 폴더 아래 Sim_Output/에 쌓인다",
    "dir": "Sim_Output",
    "csv_prefix": "fer",
    "label": "headroom"
  }
}