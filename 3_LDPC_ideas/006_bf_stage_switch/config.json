{
  "_desc": [
    "006_bf_stage_switch 고정 4회 전환 2단 모형의 FER 확인용 슬롯",
    "전환 정책 비교(기준선, genie 상한, 감지기, 재튜닝)는 scan.py가 수행",
    "스키마 설명 정본은 2_LDPC_base/workspace/_template/config.json"
  ],
  "H_matrix": {
    "dir": "../../2_LDPC_base/Input/H_matrix",
    "file": "matrix_sel_1.txt"
  },
  "decoder": {
    "use_input_llr_matrix": true,
    "llr_matrix": {
      "dir": "../../2_LDPC_base/Input/LLR",
      "file": "LLR_MATRIX_HD_matrix_sel_1.txt"
    }
  },
  "run": {
    "seed": 0,
    "max_frame_errors": 50,
    "max_frames": 320,
    "frames_per_batch": 64,
    "stop_below_fer": null,
    "progress_interval_frames": 64
  },
  "channels": {
    "type": "fixed_error",
    "fixed_error": [150, 90, 30]
  },
  "log": {
    "enabled": false,
    "items": {
      "csw_per_iter": false,
      "bit_err_per_iter": false,
      "bit_err_by_dv": false,
      "iter_histogram": false,
      "fer_vs_iter": false,
      "fail_frame_detail": false,
      "fer_curve_png": false
    }
  },
  "output": {
    "dir": "Sim_Output",
    "csv_prefix": "fer",
    "label": "bf_stage_switch_fixed4"
  }
}
